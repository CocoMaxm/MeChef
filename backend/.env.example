NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=30d

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
# Gmail needs an App Password (Google Account > Security > 2-Step Verification > App passwords)
EMAIL_PASS=
EMAIL_FROM=CuisineForMe <your-address@gmail.com>

# Where admin notifications go (defaults to EMAIL_USER)
ADMIN_EMAIL=

# Booking rules (optional)
# Free minutes kept around every booking for travel/rest (default 60)
BOOKING_BUFFER_MINUTES=60
# Minimum notice before a booking starts, in hours (default 12). Use 0 while testing.
BOOKING_MIN_LEAD_HOURS=12

# Rate limits (optional). Strict defaults apply in production, relaxed ones in development.
# API_LIMIT_PER_15MIN=300
# LOGIN_LIMIT_PER_15MIN=10
# SIGNUP_LIMIT_PER_HOUR=20

# Google sign-in (optional - the button only appears when this is set)
# Google Cloud Console > APIs & Services > Credentials > Create credentials > OAuth client ID > Web application.
# Authorised JavaScript origins: http://localhost:5000 and your live site (https://mymealchef.onrender.com)
GOOGLE_CLIENT_ID=

# Signed media uploads for chef discovery videos and photo carousels
# Cloudinary > Settings > API Keys. Upload preset is optional for this app's signed uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Public address of the website, used for links in emails (password reset). No trailing slash.
# Local: http://localhost:5000   Live: https://mymealchef.onrender.com
APP_URL=http://localhost:5000
